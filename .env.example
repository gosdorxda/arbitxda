# Daftar exchange aktif, dipisah koma. Exchange aktif: kraken, bingx, lbank, bybit, bitget, gate, poloniex, bitrue, mexc, htx, fameex, xt, bifinance, hotcoin, bigone, cryptocom, asterdex, toobit, ourbit, mgbx, btse, pionex, coinw, weex, phemex, dextrade, p2pb2b, safetrade, binance-alpha, cexio, biconomy.
ENABLED_EXCHANGES=kraken,bingx,lbank,bybit,bitget,gate,poloniex,bitrue,mexc,htx,fameex,xt,bifinance,hotcoin,bigone,cryptocom,asterdex,toobit,ourbit,mgbx,btse,pionex,coinw,weex,phemex,dextrade,p2pb2b,safetrade,binance-alpha,cexio,biconomy

# Path file SQLite (relatif ke folder project atau absolut)
DATABASE_PATH=./data/arbit.db

# API key read-only (menyusul, untuk status deposit/withdraw)
# KRAKEN_API_KEY=
# KRAKEN_API_SECRET=
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
# LBANK_API_KEY=
# LBANK_API_SECRET=
# API key read-only BingX, untuk status deposit/withdraw
BINGX_API_KEY=
BINGX_API_SECRET=

# API key read-only Bybit, untuk status deposit/withdraw + kontrak (endpoint signed /v5/asset/coin/query-info).
# Kosong = depo/wd dilewati. Bitget, Gate, Poloniex, Bitrue, HTX, FameEX, XT, BiFinance, Hotcoin, BigONE, AsterDEX, Toobit, MGBX, Pionex, CoinW, dan WEEX tidak perlu API key (endpoint publik). Dex-Trade dan P2PB2B juga tanpa key, tapi API resmi Dex-Trade/P2PB2B tidak punya endpoint status depo/wd (kolom Depo/WD kosong). SafeTrade tanpa key, dengan status depo/wd publik (`/trade/public/currencies`). Binance Alpha tanpa key; token list + exchange info publik, tanpa status depo/wd resmi (kolom Depo/WD kosong). UZX dilewati: tidak ada dokumentasi REST publik resmi yang bisa dipakai. MEXC butuh key read-only untuk depo/wd + kontrak (`/api/v3/capital/config/getall` signed). Crypto.com butuh key read-only untuk depo/wd (`private/get-currency-networks` signed; tanpa alamat kontrak di skema resmi). Ourbit, BTSE, dan Phemex butuh key read-only opsional untuk status depo/wd (tanpa key = dilewati / status terbatas).
BYBIT_API_KEY=
BYBIT_API_SECRET=

# API key read-only MEXC, untuk status deposit/withdraw + kontrak (endpoint signed /api/v3/capital/config/getall).
# Kosong = depo/wd dilewati.
MEXC_API_KEY=
MEXC_API_SECRET=

# API key read-only Crypto.com Exchange, untuk status deposit/withdraw (endpoint signed private/get-currency-networks).
# Kosong = depo/wd dilewati.
CRYPTOCOM_API_KEY=
CRYPTOCOM_API_SECRET=

# API key read-only Ourbit, untuk status deposit/withdraw + kontrak (endpoint signed /api/v3/capital/config/getall).
# Kosong = depo/wd dilewati.
OURBIT_API_KEY=
OURBIT_API_SECRET=

# API key read-only BTSE, untuk status deposit/withdraw per jaringan (Wallet v1 signed, izin Read).
# Kosong = depo/wd dilewati. BTSE tidak menyediakan alamat kontrak di API.
BTSE_API_KEY=
BTSE_API_SECRET=

# API key read-only Phemex, untuk status deposit/withdraw + kontrak (endpoint signed chainCfg / asset/info).
# Kosong = daftar chain publik saja (tanpa flag depo/wd).
PHEMEX_API_KEY=
PHEMEX_API_SECRET=


# RPC Ethereum mainnet untuk kolom "DEX Pools" (deteksi pool Uniswap V2/V3, Sushi, Balancer + quote CoW on-chain via Multicall3).
# Isi dengan URL RPC milik sendiri (Alchemy/Infura/QuickNode/node sendiri). Kosong = kolom DEX Pools tampil "RPC?".
# Chain lain pakai pola <CHAIN>_RPC_URL.
ETH_RPC_URL=

# RPC BNB Smart Chain untuk kolom "DEX Pools" (PancakeSwap V2/V3 on-chain via Multicall3). Kosong = token BEP20 tampil "RPC?".
BSC_RPC_URL=

# RPC Solana (opsional) untuk kolom "DEX Pools". Pool Raydium/Orca dibaca dari API publik resmi mereka;
# RPC ini dipakai untuk validasi mint + desimal (getTokenSupply). Kosong = tetap jalan via API resmi.
SOL_RPC_URL=
