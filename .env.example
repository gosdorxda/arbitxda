# Daftar exchange aktif, dipisah koma. Exchange aktif: kraken, bingx, lbank, bybit, bitget, gate, poloniex, bitrue, mexc, htx, fameex, xt, bifinance, hotcoin, bigone, cryptocom, asterdex, toobit, ourbit, mgbx, btse, pionex, coinw, weex, phemex, dextrade, p2pb2b.
ENABLED_EXCHANGES=kraken,bingx,lbank,bybit,bitget,gate,poloniex,bitrue,mexc,htx,fameex,xt,bifinance,hotcoin,bigone,cryptocom,asterdex,toobit,ourbit,mgbx,btse,pionex,coinw,weex,phemex,dextrade,p2pb2b

# Path file SQLite (relatif ke folder project atau absolut)
DATABASE_PATH=./data/arbit.db

# API key read-only (menyusul, untuk status deposit/withdraw)
# KRAKEN_API_KEY=
# KRAKEN_API_SECRET=
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
# LBANK_API_KEY=
# LBANK_API_SECRET=
# API key read-only BingX, untuk status deposit/withdraw
BINGX_API_KEY=
BINGX_API_SECRET=

# API key read-only Bybit, untuk status deposit/withdraw + kontrak (endpoint signed /v5/asset/coin/query-info).
# Kosong = depo/wd dilewati. Bitget, Gate, Poloniex, Bitrue, HTX, FameEX, XT, BiFinance, Hotcoin, BigONE, AsterDEX, Toobit, MGBX, Pionex, CoinW, dan WEEX tidak perlu API key (endpoint publik). Dex-Trade dan P2PB2B juga tanpa key, tapi API resminya tidak punya endpoint status depo/wd (kolom Depo/WD kosong). UZX dilewati: tidak ada dokumentasi REST publik resmi yang bisa dipakai. MEXC butuh key read-only untuk depo/wd + kontrak (`/api/v3/capital/config/getall` signed). Crypto.com butuh key read-only untuk depo/wd (`private/get-currency-networks` signed; tanpa alamat kontrak di skema resmi). Ourbit, BTSE, dan Phemex butuh key read-only opsional untuk status depo/wd (tanpa key = dilewati / status terbatas).
BYBIT_API_KEY=
BYBIT_API_SECRET=

# API key read-only MEXC, untuk status deposit/withdraw + kontrak (endpoint signed /api/v3/capital/config/getall).
# Kosong = depo/wd dilewati.
MEXC_API_KEY=
MEXC_API_SECRET=

# API key read-only Crypto.com Exchange, untuk status deposit/withdraw (endpoint signed private/get-currency-networks).
# Kosong = depo/wd dilewati.
CRYPTOCOM_API_KEY=
CRYPTOCOM_API_SECRET=

# API key read-only Ourbit, untuk status deposit/withdraw + kontrak (endpoint signed /api/v3/capital/config/getall).
# Kosong = depo/wd dilewati.
OURBIT_API_KEY=
OURBIT_API_SECRET=

# API key read-only BTSE, untuk status deposit/withdraw per jaringan (Wallet v1 signed, izin Read).
# Kosong = depo/wd dilewati. BTSE tidak menyediakan alamat kontrak di API.
BTSE_API_KEY=
BTSE_API_SECRET=

# API key read-only Phemex, untuk status deposit/withdraw + kontrak (endpoint signed chainCfg / asset/info).
# Kosong = daftar chain publik saja (tanpa flag depo/wd).
PHEMEX_API_KEY=
PHEMEX_API_SECRET=
